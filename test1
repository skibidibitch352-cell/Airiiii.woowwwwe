local function getNPCRoot(model)
    if not model or not model:IsA("Model") then return nil end
    local hum = model:FindFirstChildOfClass("Humanoid")
    local root = model:FindFirstChild("HumanoidRootPart")
    if hum and hum.Health > 0 and root and root:IsA("BasePart") then
        return root
    end
    return nil
end

local function findNearestNPC()
    local character = player.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local best, bestDistance = nil, math.huge
    for _, npc in ipairs(CollectionService:GetTagged("TestNPC")) do
        if npc:IsA("Model") and not npc:IsDescendantOf(character) then
            local root = getNPCRoot(npc)
            if root then
                local distance = (root.Position - myRoot.Position).Magnitude
                if distance < bestDistance and distance <= 250 then
                    best, bestDistance = npc, distance
                end
            end
        end
    end
    return best, bestDistance
end

RunService.Heartbeat:Connect(function()
    if not enabled then return end

    local npc, distance = findNearestNPC()
    if npc ~= currentTarget then
        clearTarget()
        if npc then
            currentTarget = npc
            currentHighlight = Instance.new("Highlight")
            currentHighlight.Name = "AiriHubTestHighlight"
            currentHighlight.FillColor = Color3.fromRGB(190, 150, 255)
            currentHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            currentHighlight.FillTransparency = 0.65
            currentHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            currentHighlight.Adornee = npc
            currentHighlight.Parent = gui
        end
    end

    if npc and distance then
        status.Text = ("NPC: %s\nDistance: %d studs"):format(npc.Name, math.floor(distance))
    else
        status.Text = "Target: no tagged NPC within 250 studs"
    end
end)

gui.Destroying:Connect(clearTarget)
